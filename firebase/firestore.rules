rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global leaderboards, written directly by the app without Firebase Auth (free Spark plan).
    // One document per player and board: leaderboards/{day|week|month}_{FRENCH|ENGLISH|ALL}_{period}/entries/{playerUuid}.
    // ALL = general board, the two languages added together.
    match /leaderboards/{board}/entries/{playerId} {
      allow read: if true;
      allow create, update: if validBoard(board)
        && playerId.matches('^[0-9a-f-]{36}$')
        && validEntry(request.resource.data, board)
        // Never lower a score; same win count means only the profile (name/avatar) may change.
        && (resource == null
          || request.resource.data.correctCount > resource.data.correctCount
          || (request.resource.data.correctCount == resource.data.correctCount
            && request.resource.data.totalMs == resource.data.totalMs));
      allow delete: if false;
    }
    match /publicPlayers/{playerId} {
      allow read: if true;
      allow create, update: if playerId.matches('^[0-9a-f-]{36}$')
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'nameKey', 'updatedAt'])
        && request.resource.data.keys().hasAll(['name', 'avatar', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && request.resource.data.avatar is int && request.resource.data.avatar >= 0 && request.resource.data.avatar < 56
        && request.resource.data.updatedAt == request.time
        // nameKey (from v1.1.3): the pseudo must be reserved by this player in the same commit or before.
        // Optional so that older app versions keep syncing until they update.
        && (!('nameKey' in request.resource.data)
          || (request.resource.data.nameKey == request.resource.data.name.lower()
            && getAfter(/databases/$(database)/documents/playerNames/$(request.resource.data.nameKey)).data.playerId == playerId));
      allow delete: if false;
    }
    // Unique pseudos, case-insensitive and whatever the avatar: playerNames/{lowercase pseudo} = owner.
    // The app creates it with a "must not exist" precondition, so two players cannot claim one pseudo.
    match /playerNames/{nameKey} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['playerId'])
        && request.resource.data.playerId is string
        && request.resource.data.playerId.matches('^[0-9a-f-]{36}$')
        && getAfter(/databases/$(database)/documents/publicPlayers/$(request.resource.data.playerId)).data.get('nameKey', '') == nameKey;
      allow update: if false;
      // Released only once the owner's public profile uses another pseudo.
      allow delete: if resource == null
        || getAfter(/databases/$(database)/documents/publicPlayers/$(resource.data.playerId)).data.get('nameKey', '') != nameKey;
    }
    match /{document=**} { allow read, write: if false; }

    function validBoard(board) {
      return board.matches('^day_(FRENCH|ENGLISH|ALL)_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        || board.matches('^week_(FRENCH|ENGLISH|ALL)_[0-9]{4}-W[0-9]{2}$')
        || board.matches('^month_(FRENCH|ENGLISH|ALL)_[0-9]{4}-[0-9]{2}$');
    }
    // One win per language and per day: 1/7/31 per language, twice that for ALL.
    function maxWins(board) {
      let base = board.matches('^day_.*') ? 1 : (board.matches('^week_.*') ? 7 : 31);
      return board.matches('^[a-z]+_ALL_.*') ? base * 2 : base;
    }
    function validEntry(data, board) {
      return data.keys().hasOnly(['name', 'avatar', 'correctCount', 'totalMs', 'updatedAt'])
        && data.keys().hasAll(['name', 'avatar', 'correctCount', 'totalMs', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 24
        && data.avatar is int && data.avatar >= 0 && data.avatar < 56
        && data.correctCount is int && data.correctCount >= 1
        && data.correctCount <= maxWins(board)
        // At most 48 hours per win.
        && data.totalMs is int && data.totalMs >= data.correctCount && data.totalMs <= data.correctCount * 172800000
        && data.updatedAt == request.time;
    }
  }
}
